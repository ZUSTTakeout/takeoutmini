{
    "name": "campus-food-api",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "build": "npm run prisma:generate && tsc -p tsconfig.json",
        "start": "node dist/main.js",
        "start:dev": "ts-node-dev --respawn src/main.ts",
        "lint": "eslint src test",
        "prisma:generate": "prisma generate",
        "test": "npm run build && jest --runInBand",
        "typecheck": "npm run prisma:generate && tsc -p tsconfig.json --noEmit"
    },
    "dependencies": {
        "@nestjs/common": "^11.0.0",
        "@nestjs/core": "^11.0.0",
        "@nestjs/platform-express": "^11.0.0",
        "@prisma/client": "^6.16.0",
        "class-transformer": "^0.5.1",
        "class-validator": "^0.14.2",
        "dotenv": "^16.6.1",
        "express": "^5.1.0",
        "jsonwebtoken": "^9.0.2",
        "reflect-metadata": "^0.2.2",
        "rxjs": "^7.8.2"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/express": "^5.0.3",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/node": "^24.3.0",
        "eslint": "^10.0.0",
        "globals": "^17.12.0",
        "jest": "^30.0.0",
        "prisma": "^6.16.0",
        "ts-node-dev": "^2.0.0",
        "typescript": "^5.9.2",
        "typescript-eslint": "^8.70.1"
    },
    "overrides": {
        "deepmerge-ts": "8.0.2",
        "multer": "2.4.0"
    }
}
