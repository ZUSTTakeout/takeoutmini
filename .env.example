# 复制为 .env 后使用。DATABASE_HOST 可填写 IP 或纯域名，不要包含协议和路径。
# 使用 Compose 时，账号和密码请采用 URL 安全字符（字母、数字、._~-）。
DATABASE_HOST=127.0.0.1
DATABASE_PORT=13306
DATABASE_NAME=campus_food
DATABASE_USER=campus
DATABASE_PASSWORD=change_me_local_db_2026
PORT=3000
JWT_SECRET=change_me_to_at_least_32_random_characters
JWT_ISSUER=campus-food-api
JWT_AUDIENCE=campus-food-miniapp
# 逗号分隔的浏览器端来源；微信小程序通常不需要配置 CORS。
CORS_ORIGINS=
# 本地联调开启；上线必须 false 并改 NODE_ENV=production。
DEV_AUTH_ENABLED=true
NODE_ENV=development
# 真机/上线需要在微信后台配置合法 HTTPS API 域名。
WECHAT_APP_ID=
WECHAT_APP_SECRET=
