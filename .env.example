# 本文件用于根目录 Docker Compose，复制为 .env 后修改密码。
MYSQL_DATABASE=campus_food
MYSQL_USER=campus
MYSQL_PASSWORD=local_dev_change_me
MYSQL_ROOT_PASSWORD=local_root_change_me
JWT_SECRET=local_development_only_replace_with_32_random_chars
# 本地联调开启；上线必须 false 并改 NODE_ENV=production。
DEV_AUTH_ENABLED=true
NODE_ENV=development
# 真机/上线需要微信后台配置合法 https / wss 域名。
WECHAT_APP_ID=
WECHAT_APP_SECRET=
